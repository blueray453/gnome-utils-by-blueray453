#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

const SPEC_CACHE_FILE = GLib.build_filenamev([
    GLib.get_home_dir(), '.cache', 'gnome-dbus-spec', 'gnome-utils.json'
]);

// Map CLI shorthand to actual D-Bus interface names
const INTERFACE_MAP = {
    windows:    'io.github.blueray453.GnomeUtils.Windows',
    workspaces: 'io.github.blueray453.GnomeUtils.Workspaces',
    tagged:     'io.github.blueray453.GnomeUtils.TaggedWindows',
    keyboard:   'io.github.blueray453.GnomeUtils.KeyboardSimulator',
    keybinding: 'io.github.blueray453.GnomeUtils.Keybinding',
};

let selectedInterfaceKey = null;

function usage() {
    const prog = System.programInvocationName || 'gnomeutils-call';
    printerr(`Usage: ${prog} -i INTERFACE METHOD [PARAMETER...]`);
    printerr('  -i, --interface NAME   Choose: windows, workspaces, tagged, keyboard, keybinding (REQUIRED)');
    printerr('  -h, --help             Show this');
    System.exit(1);
}

function loadSpec() {
    const file = Gio.File.new_for_path(SPEC_CACHE_FILE);
    if (!file.query_exists(null)) return null;
    try {
        const [ok, contents] = file.load_contents(null);
        if (!ok) return null;
        return JSON.parse(new TextDecoder().decode(contents));
    } catch (e) {
        return null;
    }
}

// Robust signature parsing using GLib's native XML parser (No Regex!)
function getMethodSignature(xml, methodName) {
    let nodeInfo;
    try {
        nodeInfo = Gio.DBusNodeInfo.new_for_xml(xml);
    } catch (e) {
        return null;
    }

    if (!nodeInfo.interfaces || nodeInfo.interfaces.length === 0) return null;
    const ifaceInfo = nodeInfo.interfaces[0];

    const methodInfo = ifaceInfo.methods.find(m => m.name === methodName);
    if (!methodInfo) return null;

    return methodInfo.in_args.map(arg => arg.signature);
}

function convertToJS(raw, expectedType) {
    const trimmed = raw.trim();
    switch (expectedType) {
        case 's': return trimmed.startsWith('"') && trimmed.endsWith('"') ? trimmed.slice(1, -1) : trimmed;
        case 'u': case 'i': case 'd': case 'x': case 't': return Number(trimmed);
        case 'b': return trimmed === 'true' || trimmed === '1';
        case 'as': return trimmed.split(',').map(s => s.trim().replace(/^"|"$/g, ''));
        default:
            printerr(`Unsupported D-Bus type "${expectedType}"`);
            System.exit(5);
    }
}

function main() {
    const args = ARGV.slice();
    if (args.length === 0) usage();

    let methodName = null;
    const params = [];

    for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        if (arg === '-h' || arg === '--help') {
            usage();
        } else if (arg === '-i' || arg === '--interface') {
            i++;
            if (i >= args.length) { printerr('Missing interface name'); usage(); }
            const name = args[i].toLowerCase();
            if (!(name in INTERFACE_MAP)) {
                printerr(`Unknown interface: "${name}". Valid: ${Object.keys(INTERFACE_MAP).join(', ')}`);
                System.exit(1);
            }
            selectedInterfaceKey = name;
        } else {
            if (methodName === null) methodName = arg;
            else params.push(arg);
        }
    }

    if (!selectedInterfaceKey) { printerr('ERROR: interface (-i) is required.'); usage(); }
    if (!methodName) { printerr('ERROR: METHOD is required'); usage(); }

    // 1. Load Cache
    const spec = loadSpec();
    if (!spec) {
        printerr('gnomeutils-call: gnome-utils extension is not enabled');
        System.exit(2);
    }

    // 2. Locate Interface in Cache
    const ifaceName = INTERFACE_MAP[selectedInterfaceKey];
    const ifaceData = spec.interfaces[ifaceName];
    if (!ifaceData || !ifaceData.xml || !ifaceData.object_path) {
        printerr(`gnomeutils-call: interface "${ifaceName}" missing from cache`);
        System.exit(2);
    }

    const syncMethodName = methodName + 'Sync';

    // 3. Build Proxy
    let proxy;
    try {
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(ifaceData.xml);
        proxy = new ProxyClass(Gio.DBus.session, spec.bus_name, ifaceData.object_path);
    } catch (e) {
        printerr(`gnomeutils-call: could not build proxy: ${e.message}`);
        System.exit(2);
    }

    if (typeof proxy[syncMethodName] !== 'function') {
        printerr(`Method "${methodName}" not found in interface ${selectedInterfaceKey}`);
        System.exit(4);
    }

    // 4. Parse Signature & Arguments
    let argTypes = getMethodSignature(ifaceData.xml, methodName);
    if (!argTypes) {
        printerr(`Could not parse signature for "${methodName}"`);
        System.exit(4);
    }

    if (params.length !== argTypes.length) {
        printerr(`Expected ${argTypes.length} arguments, but got ${params.length}`);
        System.exit(4);
    }

    let jsArgs = params.map((p, i) => convertToJS(p, argTypes[i]));

    // 5. Execute Call
    try {
        let result = proxy[syncMethodName](...jsArgs);
        if (result && result.length > 0) {
            let outValue = result[0];
            print(typeof outValue === 'string' ? outValue : String(outValue));
        }
        System.exit(0);
    } catch (e) {
        if (e instanceof Gio.DBusError) Gio.DBusError.strip_remote_error(e);
        printerr(`Method call failed: ${e.message}`);
        System.exit(5);
    }
}

main();