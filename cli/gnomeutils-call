#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

const BUS_NAME = 'org.gnome.Shell';
const INTROSPECTABLE_INTERFACE = 'org.freedesktop.DBus.Introspectable';

const INTERFACES = {
    windows: { path: '/org/gnome/Shell/Extensions/GnomeUtilsWindows', iface: 'org.gnome.Shell.Extensions.GnomeUtilsWindows' },
    workspaces: { path: '/org/gnome/Shell/Extensions/GnomeUtilsWorkspaces', iface: 'org.gnome.Shell.Extensions.GnomeUtilsWorkspaces' },
    tagged: { path: '/org/gnome/Shell/Extensions/GnomeUtilsTaggedWindows', iface: 'org.gnome.Shell.Extensions.GnomeUtilsTaggedWindows' },
    keyboard: { path: '/org/gnome/Shell/Extensions/GnomeUtilsKeyboardSimulator', iface: 'org.gnome.Shell.Extensions.GnomeUtilsKeyboardSimulator' },
};

let selectedInterface = null;

function usage() {
    const prog = System.programInvocationName || 'gnomeutils-call';
    printerr(`Usage: ${prog} -i INTERFACE METHOD [PARAMETER...]`);
    printerr('  -i, --interface NAME   Choose: windows, workspaces, tagged, keyboard (REQUIRED)');
    printerr('  -h, --help             Show this');
    printerr('Parameters are automatically converted to JS primitives before D-Bus packing.');
    printerr('Write strings as-is, arrays as comma-separated values.');
    printerr('Void methods produce no output.');
    System.exit(1);
}

// ----------------------------------------------------------------------
// Extract the specific <interface> block from the full introspection XML
// ----------------------------------------------------------------------
function extractInterfaceXml(fullXml, interfaceName) {
    // Match the specific interface block using Regex
    const regex = new RegExp(`<interface\\s+name="${interfaceName}"[^>]*>[\\s\\S]*?</interface>`);
    const match = fullXml.match(regex);
    if (!match) {
        throw new Error(`Interface "${interfaceName}" not found in introspection XML`);
    }
    // makeProxyWrapper requires a valid <node> wrapper around the interface
    return `<node>\n${match[0]}\n</node>`;
}

// ----------------------------------------------------------------------
// Fetch XML via Introspect and create a Proxy Class
// ----------------------------------------------------------------------
function getProxyAndXml(busName, objectPath, interfaceName) {
    let introProxy;
    try {
        introProxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION,
            Gio.DBusProxyFlags.NONE,
            null,
            busName,
            objectPath,
            INTROSPECTABLE_INTERFACE,
            null
        );
    } catch (e) {
        printerr(`Could not create introspection proxy: ${e.message}`);
        System.exit(2);
    }

    let fullXml;
    try {
        const result = introProxy.call_sync(
            'Introspect',
            null,
            Gio.DBusCallFlags.NONE,
            -1,
            null
        );
        fullXml = result.deepUnpack()[0];
    } catch (e) {
        printerr(`Introspect call failed: ${e.message}`);
        System.exit(3);
    }

    try {
        // Extract ONLY the target interface XML to avoid binding to DBus.Properties
        const ifaceXml = extractInterfaceXml(fullXml, interfaceName);

        // This is the magic function that generates the proxy class
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(ifaceXml);
        const proxy = new ProxyClass(Gio.DBus.session, busName, objectPath);
        return { proxy, xml: fullXml }; // Return full XML for signature parsing
    } catch (e) {
        printerr(`Failed to create proxy wrapper: ${e.message}`);
        System.exit(3);
    }
}

// ----------------------------------------------------------------------
// Extract method signature from XML (needed to parse CLI args correctly)
// ----------------------------------------------------------------------
function getMethodSignature(xml, methodName) {
    const methodRegex = new RegExp(`<method name="${methodName}"[^>]*>([\\s\\S]*?)</method>`);
    const match = xml.match(methodRegex);
    if (!match) return null;

    const methodBody = match[1];
    const argTags = methodBody.match(/<arg\s+[^>]*>/g) || [];
    const argTypes = [];
    for (const tag of argTags) {
        if (tag.includes('direction="in"')) {
            const typeMatch = tag.match(/type="([^"]+)"/);
            if (typeMatch) argTypes.push(typeMatch[1]);
        }
    }
    return argTypes;
}

// ----------------------------------------------------------------------
// Convert CLI string argument to JS primitive based on D-Bus type
// ----------------------------------------------------------------------
function convertToJS(raw, expectedType) {
    const trimmed = raw.trim();

    switch (expectedType) {
        case 's':   // string
            return trimmed.startsWith('"') && trimmed.endsWith('"') ? trimmed.slice(1, -1) : trimmed;
        case 'u':   // unsigned int
        case 'i':   // signed int
        case 'd':   // double
        case 'x':   // int64
        case 't':   // uint64
            return Number(trimmed);
        case 'b':   // boolean
            return trimmed === 'true' || trimmed === '1';
        case 'as':  // array of strings
            return trimmed.split(',').map(s => s.trim().replace(/^"|"$/g, ''));
        default:
            printerr(`Unsupported D-Bus type "${expectedType}" for argument`);
            System.exit(5);
    }
}

function main() {
    const args = ARGV.slice();
    if (args.length === 0) usage();

    let methodName = null;
    const params = [];

    for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        if (arg === '-h' || arg === '--help') {
            usage();
        } else if (arg === '-i' || arg === '--interface') {
            i++;
            if (i >= args.length) {
                printerr('Missing interface name');
                usage();
            }
            const name = args[i].toLowerCase();
            if (!(name in INTERFACES)) {
                printerr(`Unknown interface: "${name}". Valid: ${Object.keys(INTERFACES).join(', ')}`);
                System.exit(1);
            }
            selectedInterface = name;
        } else {
            if (methodName === null) {
                methodName = arg;
            } else {
                params.push(arg);
            }
        }
    }

    if (selectedInterface === null) {
        printerr('ERROR: interface (-i) is required.');
        usage();
    }
    if (methodName === null) {
        printerr('ERROR: METHOD is required');
        usage();
    }

    const ifaceInfo = INTERFACES[selectedInterface];
    const objectPath = ifaceInfo.path;
    const interfaceName = ifaceInfo.iface;

    // ---- 1. Get Proxy and XML ----
    let proxy, xml;
    try {
        const res = getProxyAndXml(BUS_NAME, objectPath, interfaceName);
        proxy = res.proxy;
        xml = res.xml;
    } catch (e) {
        printerr(`Connection failed: ${e.message}`);
        printerr('Is the extension enabled?');
        System.exit(2);
    }

    // ---- 2. Check method and get signature ----
    const syncMethodName = methodName + 'Sync';
    if (typeof proxy[syncMethodName] !== 'function') {
        printerr(`Method "${methodName}" not found in interface ${selectedInterface}`);
        System.exit(4);
    }

    let argTypes = getMethodSignature(xml, methodName);
    if (!argTypes) {
        printerr(`Could not parse signature for "${methodName}"`);
        System.exit(4);
    }

    if (params.length !== argTypes.length) {
        printerr(`Expected ${argTypes.length} arguments, but got ${params.length}`);
        System.exit(4);
    }

    // ---- 3. Convert CLI args to JS primitives ----
    let jsArgs = params.map((p, i) => convertToJS(p, argTypes[i]));

    // ---- 4. Call the method ----
    try {
        // We call the generated Sync method directly with JS primitives!
        let result = proxy[syncMethodName](...jsArgs);

        // makeProxyWrapper returns an array of OUT arguments.
        if (result && result.length > 0) {
            let outValue = result[0];
            if (typeof outValue === 'string') {
                print(outValue);
            } else {
                print(String(outValue));
            }
        }
        System.exit(0);
    } catch (e) {
        printerr(`Method call failed: ${e.message}`);
        System.exit(5);
    }
}

main();